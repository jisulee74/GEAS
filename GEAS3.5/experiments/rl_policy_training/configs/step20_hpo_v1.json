{
  "schema_version": "geas35.rl.step20.config.v1",
  "trials_per_crop": 30,
  "sampler_seed": 42,
  "split_policy": {
    "fit": "train",
    "objective": "validation",
    "test": "locked"
  },
  "objective": {
    "primary": "mean_reward_per_scheduled_valid_step",
