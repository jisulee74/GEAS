      "action_instability"
    ]
  },
  "successive_halving": {
    "rungs_environment_steps": [
      1000000,
      2000000
    ],
    "promotion_fraction": 0.3333333333333333,
    "top_configuration_seeds": [
      42,
      43,
      44
    ],
    "top_configurations_for_multi_seed": 3
  },
  "search_space": {
    "learning_rate": [
      1e-05,
      0.001
    ],
    "rollout_length": [
      512,
      1024,
      2048,
      4096
    ],
    "minibatch_size": [
      64,
      128,
      256
    ],
    "update_epochs": [
      3,
      5,
      10
    ],
    "gamma": [
      0.95,
      0.98,
      0.99,
      0.995
    ],
    "gae_lambda": [
      0.9,
      0.95,
      0.98
    ],
    "clip_range": [
      0.1,
      0.2,
      0.3
    ],
    "entropy_coefficient": [
      0.0,
      0.001,
      0.01,
      0.02
    ],
    "value_coefficient": [
      0.25,
      0.5,
      1.0
    ],
    "target_kl": [
      0.01,
      0.02,
      0.03,
      0.05
    ],
    "network_width": [
      64,
      128,
      256
    ],
    "network_depth": [
      2,
      3
    ],
    "beta_concentration_floor": [
      1.01,
      1.1,
      1.5
    ]
