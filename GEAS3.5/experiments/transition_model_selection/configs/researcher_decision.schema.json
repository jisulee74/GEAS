{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEAS Transition Researcher Decision v1",
  "type": "object",
  "required": ["schema_version", "decision_author", "decided_at_utc", "decision_source", "framework_generated_recommendation", "decisions"],
  "properties": {
    "schema_version": {"const": "geas35.transition.researcher_decision.v1"},
    "decision_author": {"type": "string", "minLength": 1},
    "decided_at_utc": {"type": "string", "minLength": 1},
    "decision_source": {"const": "researcher"},
    "framework_generated_recommendation": {"const": false},
    "decisions": {
      "type": "object",
      "required": ["strawberry", "melon", "cucumber"],
      "additionalProperties": false,
      "properties": {
        "strawberry": {"$ref": "#/$defs/cropDecision"},
        "melon": {"$ref": "#/$defs/cropDecision"},
        "cucumber": {"$ref": "#/$defs/cropDecision"}
      }
    }
  },
  "$defs": {
    "cropDecision": {
      "type": "object",
      "required": ["candidate_name", "rationale", "validation_evidence", "resource_tradeoff", "deployment_constraints"],
      "properties": {
        "candidate_name": {"enum": ["persistence", "linear_regression", "linear_svr", "knn", "extra_trees", "lightgbm", "xgboost", "mlp"]},
        "rationale": {"type": "string", "minLength": 10},
        "validation_evidence": {"type": "array", "minItems": 1},
        "resource_tradeoff": {"type": "string", "minLength": 10},
        "deployment_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
